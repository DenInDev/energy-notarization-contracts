// Single-owner experimental workload.
Program EnergyLifecycleOnce {
  state {
    owner: address
    last: string
    total: string
    result: string
    initialized: bool
  }

  event Updated(operation: string)

  constructor(initial_total: string) {
    self.owner = origin
    self.last = ""
    self.total = fhe_ser(fhe_deser(initial_total))
    self.result = ""
    self.initialized = false
  }

  fn notarize(input: string): bool {
    require(caller == self.owner, "owner only")
    self.last = fhe_ser(fhe_deser(input))
    self.initialized = true
    emit Updated("notarize")
    return true
  }

  fn add(): bool {
    require(caller == self.owner, "owner only")
    require(self.initialized, "no entry")
    let pk = fhe_load_pk(caller)
    self.total = fhe_ser(fhe_add(pk, fhe_deser(self.total), fhe_deser(self.last)))
    emit Updated("add")
    return true
  }

  fn mul_scalar(scalar: int): bool {
    require(caller == self.owner, "owner only")
    require(self.initialized, "no entry")
    require(scalar >= 0, "negative scalar")
    let pk = fhe_load_pk(caller)
    self.result = fhe_ser(fhe_scale(pk, fhe_deser(self.last), scalar))
    emit Updated("mul_scalar")
    return true
  }

  fn mean_field(): bool {
    require(caller == self.owner, "owner only")
    require(self.initialized, "no entry")
    let pk = fhe_load_pk(caller)
    let sum = fhe_add(pk, fhe_deser(self.last), fhe_deser(self.total))
    self.result = fhe_ser(fhe_div_const(pk, sum, 2))
    emit Updated("mean_field")
    return true
  }

  view fn get_last(): string {
    require(caller == self.owner, "owner only")
    return self.last
  }

  view fn get_total(): string {
    require(caller == self.owner, "owner only")
    return self.total
  }

  view fn get_result(): string {
    require(caller == self.owner, "owner only")
    return self.result
  }

  view fn mean_probe(left: string, right: string): string {
    require(caller == self.owner, "owner only")
    let pk = fhe_load_pk(caller)
    return fhe_ser(fhe_div_const(pk, fhe_add(pk, fhe_deser(left), fhe_deser(right)), 2))
  }
}

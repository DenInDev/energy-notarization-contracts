{
  "name": "energy-notarization-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Reproducible Sepolia benchmarks for plaintext, Zama fhEVM, and Fhenix CoFHE energy notarization contracts.",
  "scripts": {
    "postinstall": "node scripts/patch-decryption-polling.cjs",
    "sdk:patch-polling": "node scripts/patch-decryption-polling.cjs",
    "clean": "rimraf artifacts cache types dist",
    "compile": "hardhat compile",
    "typecheck": "tsc --noEmit",
    "contracts:generate": "node scripts/generate-study-contracts.cjs",
    "contracts:check": "node scripts/generate-study-contracts.cjs --check && node scripts/generate-uniform-lifecycle-contracts.cjs --check",
    "test": "hardhat test --network hardhat",
    "verify": "npm run contracts:check && npm run compile && npm run typecheck && npm test",
    "benchmark:accounts": "hardhat benchmark:accounts",
    "benchmark:accounts:balances": "hardhat benchmark:accounts:balances --network sepolia",
    "study:plan": "hardhat benchmark:study",
    "study:concurrency": "hardhat benchmark:study --suite concurrency",
    "study:circuits": "hardhat benchmark:study --suite circuits",
    "study:test": "hardhat test --network hardhat test/studies.test.ts test/studyContracts.test.ts",
    "benchmark:pilot": "hardhat benchmark:energy:lifecycle --network sepolia --runs 3 --platform all --seed pilot",
    "benchmark:sepolia": "hardhat benchmark:energy:lifecycle --network sepolia --runs 50 --platform all --seed reviewer-revision-20260917",
    "analysis:test": "python scripts/analysis/tests/test-lifecycle-analysis.py",
    "analysis:availability:test": "python scripts/analysis/tests/test-availability.py",
    "analyze": "python scripts/analysis/analyze-lifecycle.py",
    "analyze:availability": "python scripts/analysis/analyze-availability.py"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cofhe/sdk-current": "npm:@cofhe/sdk@1.0.1",
    "@fhenixprotocol/cofhe-contracts-current": "npm:@fhenixprotocol/cofhe-contracts@0.2.0",
    "@fhevm/solidity": "0.11.1",
    "@zama-fhe/relayer-sdk": "0.4.1"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "0.4.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.30",
    "ethers": "6.16.0",
    "hardhat": "2.28.4",
    "mocha": "11.7.5",
    "rimraf": "6.1.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
